<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_DATABASE" value="servio_finance_test_db"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="IDENTITY_INTERNAL_BASE_URL" value="http://localhost:8001"/>
        <env name="ORDER_INTERNAL_BASE_URL" value="http://localhost:8005"/>
        <env name="FINANCE_GATEWAY_KEY" value="servio_local_gateway_key_2026"/>
        <env name="FINANCE_INTERNAL_SERVICE_KEY" value="servio_local_internal_service_key_2026"/>
        <env name="SERVICE_GATEWAY_KEY" value="servio_local_gateway_key_2026"/>
        <env name="SERVICE_INTERNAL_SERVICE_KEY" value="servio_local_internal_service_key_2026"/>
        <env name="FINANCE_MOCK_PAYMENT_ENABLED" value="true"/>
        <env name="FINANCE_MOCK_PAYOUT_ENABLED" value="true"/>
        <env name="FINANCE_STEP_UP_SECRET" value="servio_step_up_secret_2026"/>
    </php>
</phpunit>
